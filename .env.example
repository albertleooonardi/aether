# Copy and fill in. Both .env.local and .env are gitignored and both are loaded
# (api/_lib/core.js reads .env.local FIRST, so it wins on conflicts); .env.local
# is the CRA convention and the one this project uses.
#   cp .env.example .env.local

# ── Frontend (required) ───────────────────────────────────────────────────────
# WeatherAPI.com key — free tier at https://www.weatherapi.com/
# Note: REACT_APP_* values are baked into the production bundle and are public
# once deployed. Restrict the key at the provider if you ship this.
REACT_APP_WEATHER_API_KEY=

# Same WeatherAPI key for the backend's own lookups (the chat's get_weather /
# get_route tools). Read in preference to REACT_APP_WEATHER_API_KEY, which it
# falls back to — so this is optional, but setting it lets you keep a separate,
# unrestricted key server-side and expose only a restricted one in the bundle.
WEATHER_API_KEY=

# ── Backend AI providers (optional) ───────────────────────────────────────────
# Leave both blank and the chat falls back to the local deterministic assistant.
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# gemini-flash-latest exhausts its free-tier daily quota almost immediately, and
# an exhausted tier does not always answer 429 — it has been measured holding the
# connection open past the full 30s timeout. Lite draws on a separate bucket.
GEMINI_MODEL=gemini-flash-lite-latest

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Which provider leads; the other takes over on quota/rate-limit errors.
AI_PRIMARY=gemini

# ── Token management (optional) ───────────────────────────────────────────────
AI_MAX_OUTPUT_TOKENS=450   # reply length cap
AI_HISTORY_TURNS=6         # trailing MESSAGES sent as context (6 = 3 exchanges)
AI_COOLDOWN_MS=1800000     # how long a rate-limited provider is sidelined (30 min)
GEMINI_TOKEN_BUDGET=0      # daily token cap, 0 = unlimited
GEMINI_THINKING_BUDGET=0   # Gemini thinking tokens, 0 = off
GROQ_TOKEN_BUDGET=0

# ── Chat-turn logging (optional) ───────────────────────────────────────────────
# Leave blank and /api/log no-ops — the chat is unaffected either way. SERVICE_KEY
# is the Supabase service_role key: server-side only, bypasses RLS, must never be
# exposed through a REACT_APP_* var.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# If you change this, update the "proxy" field in package.json to match.
PORT=3001
